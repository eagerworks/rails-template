{
  "family": "rails-template",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::184967710807:role/rails-template-dev-task-execution-role",
  "taskRoleArn": "arn:aws:iam::184967710807:role/rails-template-dev-task-role",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "184967710807.dkr.ecr.us-east-1.amazonaws.com/rails-template-dev:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "EXAMPLE_ENV", "value": "dev" }
      ],
      "secrets": [
            {
                "name": "RDS_HOST",
                "valueFrom": "arn:aws:secretsmanager:us-east-1:184967710807:secret:rails-template-dev-infra:RDS_HOST::"
            },
            {
                "name": "RDS_PASSWORD",
                "valueFrom": "arn:aws:secretsmanager:us-east-1:184967710807:secret:rails-template-dev-infra:RDS_PASSWORD::"
            },
            {
                "name": "RAILS_MASTER_KEY",
                "valueFrom": "arn:aws:secretsmanager:us-east-1:184967710807:secret:rails-template-app-secrets:RAILS_MASTER_KEY::"
            }
        ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rails-template-dev",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "web"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3000/up || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
