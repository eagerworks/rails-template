To create nested forms, we suggest using the `fields_for` helper.
You can update the form using turbo by sending the form with a custom button value,
and then building new associations in the controller:

```rb
def update
  @user = User.find(params[:id])
  @user.assign_attributes(user_params)

  if params[:button] == "add_phone_number"
    @user.phone_numbers.build
    return render :edit
  end

  if @user.save
    flash.now[:success] = "User updated successfully"
    # Renders updata.turbo_stream.erb
  else
    render :edit, status: :unprocessable_entity
  end
end
```

```erb
<%%= turbo_frame_tag user do %>
  <%%= component_form_with model: user do |form| %>
    <%%= card_component do |card| %>
      <%% card.with_header do %>
        <h3 class="text-lg leading-6 font-medium text-gray-900">
          Edit User
        </h3>
      <%% end %>

      <div class="text-left">
        <%%= form.text_field_component :email, type: :email %>
        <div class="grid grid-cols-2 gap-4">
          <%%= form.text_field_component :first_name %>
          <%%= form.text_field_component :last_name %>
        </div>

        <div class="mt-4">
          <%%= card_component do |card| %>
            <%% card.with_header_content('Phone numbers') %>
            <%%= form.fields_for :phone_numbers do |f| %>
              <%%= nested_fields_component(form: f) do %>
                <div class="flex items-start mt-2 gap-4">
                  <%%= f.text_field_component(:number, margin: false, show_label: false) %>
                  <%%= button_component(size: :xl, color: :red, type: 'button', data: { action: 'nested-fields#destroy' }) do %>
                    <%%= heroicon('trash', options: { class: 'size-4' }) %>
                  <%% end %>
                </div>
              <%% end %>
            <%% end %>
            <%% card.with_footer do %>
              <div class="flex justify-end">
                <%%= button_component(value: 'add_phone_number') do %>
                  Add phone number
                <%% end %>
              </div>
            <%% end %>
          <%% end %>
        </div>
      </div>

      <%% card.with_footer do %>
        <%%= button_component do %>
          Save
        <%% end %>
      <%% end %>
    <%% end %>
  <%% end %>
<%% end %>
```

We also have the [NestedFields](<%= lookbook_inspect_path('form/nested_fields/default') %>)
component, that allows you to create a delete button for each nested field.

