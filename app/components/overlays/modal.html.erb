<div x-data="modal" @turbo:submit-end="handleFormSubmit">
  <%= content %>

  <div class="relative z-10" aria-labelledby="modal-title" role="dialog" aria-modal="true" x-show="isOpen">
    <div class="fixed inset-0 bg-gray-500/75" aria-hidden="true" x-ref="backdrop"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto" x-ref="panel">
      <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
        <div class="relative sm:w-full sm:max-w-sm" @click.outside="close">
          <% if turbo? %>
            <%= turbo_frame_tag turbo_frame, '@turbo:frame-load': 'open' %>
          <% else %>
            <%= panel %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


