<%= render Layout::Card.new(padding: false) do %>
  <div class="divide-y divide-gray-100">
    <% if items? %>
      <ul class="<%= class_list('py-1', 'divide-y divide-gray-100': @divider) %>" role="none">
        <% items.each do |item| %>
          <%= item %>
        <% end %>
      </ul>
    <% end %>

    <% sections.each do |section| %>
      <%= section %>
    <% end %>
  </div>
<% end %>
