<div
  class="relative inline-block text-left"
  data-controller="dropdown"
  data-action="click@window->dropdown#removeFocus"
>
  <div>
    <% if button? %>
      <div
        aria-haspopup="true"
        data-dropdown-target="button"
        data-action="click->dropdown#toggle"
        aria-expanded="false"
        aria-controls="dropdown"
      >
        <%= button %>
      </div>
    <% else %>
      <button
        type="button"
        class="inline-flex w-full justify-center gap-x-1.5 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:ring-2 <%= focus_classes %>"
        id="menu-button"
        aria-haspopup="true"
        data-dropdown-target="button"
        data-action="dropdown#toggle"
        aria-expanded="false"
        aria-controls="dropdown"
      >
        <%= content %>
        <svg class="-mr-1 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      </button>
    <% end %>
  </div>

  <div
    data-dropdown-target="dropdown"
    class="<%= align_classes %> absolute z-10 mt-2 w-56 rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none hidden transition duration-100 ease-in opacity-0 scale-95"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="menu-button"
    tabindex="-1"
    id="dropdown"
  >
    <div class="py-1" role="none">
      <% items.each do |item| %>
        <%= item %>
      <% end %>
    </div>
  </div>
</div>
