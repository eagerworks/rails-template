<div class="<%= class_list('w-full', 'mt-2': margin) %>">
  <% if show_label %>
    <div class="mb-2">
      <%= label %>
    </div>
  <% end %>

  <div class="relative">
    <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
      <%= heroicon('calendar', options: { class: 'size-4 text-gray-500' }) %>
    </div>
    <%= form.text_field name, class: classes, value: formatted_date, 'x-data': "datePicker('#{picker_format}')" %>
  </div>

  <% if error? %>
    <p class="mt-2 text-sm text-red-600">
      <%= error %>
    </p>
  <% elsif description? %>
    <p class="mt-2 text-sm text-gray-500">
      <%= description %>
    </p>
  <% end %>
</div>
