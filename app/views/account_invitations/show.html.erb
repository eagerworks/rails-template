<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <img class="mx-auto h-10 w-auto" src="https://tailwindui.com/plus/img/logos/mark.svg?color=indigo&shade=600" alt="Your Company">
    <h2 class="mt-6 text-center text-2xl/9 font-bold tracking-tight text-gray-900">
      Join <%= @account.name %>
    </h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <%= card_component(padding: :lg) do %>
      <div class="text-center">
        <b><%= @inviter.full_name %></b>
        has invited you to join
        <b><%= @account.name %>.</b>
      </div>

      <div class="flex justify-center gap-3 mt-4">
        <%= link_button_component(href: url_for(@account_invitation), data: { turbo_method: :put }) do %>
          Accept Invitation
        <% end %>
        <%= link_button_component(href: url_for(@account_invitation), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, variant: :secondary) do %>
          Decline
        <% end %>
      </div>
    <% end %>
  </div>
</div>
