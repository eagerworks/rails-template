<%= turbo_frame_tag :credentials do %>
  <h2 class="text-base/7 font-semibold text-gray-900">Passkeys</h2>

  <div class="mt-3">
    <%= card_component do |card| %>
      <% if @credentials.any? %>
        <% card.with_header do %>
          <div class="flex justify-between">
            <h2 class="text-base/7 font-semibold text-gray-900">Your passkeys</h2>
            <%= link_button_component(href: new_credential_path, data: { turbo_frame: '_top' }) do %>
              Add a passkey
            <% end %>
          </div>
        <% end %>
      <% end %>
      <% if @credentials.any? %>
        <ul class="divide-y divide-gray-200">
          <%= render @credentials %>
        </ul>
      <% else %>
        <div class="text-center space-y-4">
          <h2 class="text-base/7 font-semibold text-gray-900">
            Passwordless sign-in with passkeys
          </h2>
          <p class="text-base/6 text-gray-700 text-center">
            Passkeys are credentials that validate your identity using touch, facial recognition,
            a device password, or a PIN. They can be used as a password replacement or as a 2FA method.
            Passkeys can be used for sign-in as a simple and secure alternative to your password
            and two-factor credentials.
          </p>
          <%= link_button_component(href: new_credential_path, data: { turbo_frame: '_top' }) do %>
            Add a passkey
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
