<li class="py-3">
  <div class="flex gap-2 items-center">
    <%= heroicon('key', variant: :outline, options: { class: 'size-5' }) %>
    <span class="font-semibold">
      <%= credential.name %>
    </span>
  </div>
  <span class="text-sm/6 text-gray-500">
    Added on <%= credential.created_at.strftime('%B %d, %Y') %>
    |
    <% if credential.last_used_at %>
      Last used <%= time_ago_in_words(credential.last_used_at) %>
    <% else %>
      Never used
    <% end %>
  </span>
</li>
