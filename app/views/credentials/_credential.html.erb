<li class="py-3" id="<%= dom_id(credential) %>" x-data="{ editing: <%= !credential.valid? %> }">
  <div x-show="!editing">
    <div class="flex justify-between">
      <div class="flex gap-2 items-center">
        <%= heroicon('key', variant: :outline, options: { class: 'size-5' }) %>
        <span class="font-semibold">
          <%= credential.name %>
        </span>
      </div>

      <div class="flex gap-2">
        <%= button_component(variant: :secondary, '@click': 'editing = true') do %>
          <%= heroicon('pencil', options: { class: 'size-5' }) %>
        <% end %>
        <%= link_button_component(
          href: credential_path(credential), color: 'red', data: {
            turbo_method: 'delete',
            turbo_confirm: 'Are you sure? You will no longer be able to use it to sign-in to your account.'
          }
        ) do %>
          <%= heroicon('trash', options: { class: 'size-5' }) %>
        <% end %>
      </div>
    </div>

    <span class="text-sm/6 text-gray-500">
      Added on <%= credential.created_at.strftime('%B %d, %Y') %>
      |
      <% if credential.last_used_at %>
        Last used <%= time_ago_in_words(credential.last_used_at) %> ago
      <% else %>
        Never used
      <% end %>
    </span>
  </div>

  <%= component_form_with model: credential, html: { 'x-show': 'editing' } do |form| %>
    <div class="flex gap-2 items-baseline">
      <%= form.text_field_component :name, show_label: false, margin: false %>
      <%= button_component(size: :lg) do %>
        Save
      <% end %>
      <%= button_component(variant: :secondary, size: :lg, type: 'button', '@click': 'editing = false') do %>
        Cancel
      <% end %>
    </div>
  <% end %>
</li>
