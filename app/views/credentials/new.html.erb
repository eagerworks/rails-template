<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-2xl/9 font-bold tracking-tight text-gray-900">Create passkey</h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[350px]">
    <%= card_component() do %>
      <div x-data="passkey(<%= @options.to_json %>)">
        <div class="space-y-5">
          <%= heroicon('key', variant: :outline, options: { class: 'size-10 mx-auto text-indigo-600' }) %>
          <div class="space-y-5" x-show="!credential">
            <p class="text-base/6 text-gray-700 text-center">
              When you are ready, authenticate using the button below.
            </p>
            <div x-show="error">
              <%= alert_component(type: :error) do %>
                Authentication failed
              <% end %>
            </div>
            <%= button_component(width: :full, '@click': 'createCredential') do %>
              Use passkey
            <% end %>
          </div>

          <%= component_form_with model: @credential, html: { 'x-show': 'credential' } do |form| %>
            <%= hidden_field_tag :public_key_credential, nil, ':value': 'credential' %>
            <%= form.text_field_component :name, required: true do |field| %>
              <% field.with_description do %>
                A name for the passkey or device this passkey is associated with.
              <% end %>
            <% end %>

            <div class="mt-5">
              <%= button_component(width: :full) do %>
                Create passkey
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
