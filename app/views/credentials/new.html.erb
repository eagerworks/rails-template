<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-2xl/9 font-bold tracking-tight text-gray-900">Create passkey</h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <%= card_component(padding: :lg) do %>
      <div x-data="passkey(<%= @options.to_json %>)">
        <%= form_with url: credentials_path, html: { 'x-ref': 'form' } do |form| %>
          <%= form.hidden_field :public_key_credential, ':value': 'credential' %>
        <% end %>
        <div class="space-y-4">
          <p class="text-base/6 text-gray-700 text-center">
            When you are ready, authenticate using the button below.
          </p>
          <%= button_component(width: :full, '@click': 'create') do %>
            Use passkey
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
