<%= card_component do |card| %>
  <% card.with_header do %>
    <div class="flex items-center gap-2">
      <div class="flex gap-3 items-center">
        <%= avatar_component(account: account) %>

        <h2 class="text-base/7 font-semibold">
          <%= link_component(href: url_for(account)) do %>
            <%= account.name %>
          <% end %>
        </h2>
      </div>

      <%= heroicon 'chevron-right', options: { class: 'size-5 text-gray-400' } %>

      <h2 class="text-base/7 font-semibold text-gray-900">
        Invite User
      </h2>
    </div>
  <% end %>

  <%= component_form_with(model: [account, account_invitation]) do |form| %>
    <%= form.text_field_component :name %>
    <%= form.text_field_component :email %>
    <%= form.radio_buttons_component(:role) do |radio_buttons| %>
      <% radio_buttons.with_option(value: 'admin') %>
      <% radio_buttons.with_option(value: 'member') %>
    <% end %>

    <div class="mt-4 flex gap-3">
      <%= button_component do %>
        <%= account_invitation.persisted? ? 'Update' : 'Invite' %>
      <% end %>
      <%= link_button_component(href: account_account_invitation_path(account, account_invitation), data: { turbo_method: 'delete' }, color: :red) do %>
        Delete
      <% end %>
    </div>
  <% end %>
<% end %>
