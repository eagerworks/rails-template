<% content_for :title, "Friends" %>

<div class="mx-auto max-w-7xl lg:px-8 w-full my-8 lg:my-10">
  <%= breadcrumbs_component do |breadcrumbs| %>
    <% breadcrumbs.with_item(href: '#').with_content('Friends') %>
  <% end %>

  <div class="mt-5">
    <%= card_component(padding: false) do |card| %>
      <% card.with_header do %>
        <div class="flex justify-between items-center">
          <h2 class="text-base/7 font-semibold text-gray-900">Friends</h2>
          <%= link_button_component(href: new_friend_path, size: :lg) do %>
            New friend
          <% end %>
        </div>
      <% end %>

      <%= table_component do |table| %>
        <% table.with_header(align: :left).with_content('Name') %>
        <% table.with_header_content('Birth Date') %>
        <% table.with_header_content('Best Friend') %>
        <% table.with_header_content('Awards') %>
        <% table.with_header_content('Height') %>
        <% table.with_header_content('Gender') %>
        <% table.with_header_content('') %>

        <%= render @friends %>
      <% end %>
    <% end %>
  </div>
</div>
