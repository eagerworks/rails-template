<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <img class="mx-auto h-10 w-auto" src="https://tailwindui.com/plus/img/logos/mark.svg?color=indigo&shade=600" alt="Your Company">
    <h2 class="mt-6 text-center text-2xl/9 font-bold tracking-tight text-gray-900">Sign in to your account</h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <%= card_component(padding: :lg) do %>
      <%= component_form_with model: @user, url: user_session_path do |form| %>
        <div class="space-y-6">
          <%= form.text_field_component :email, label: 'Email address', autocomplete: 'email' %>
          <%= form.text_field_component :password, type: 'password', autocomplete: 'current-password' %>

          <div class="flex items-center justify-between">
            <%= form.check_box_component :remember_me %>

            <div class="text-sm/6">
              <%= link_component(href: new_user_password_path) do %>
                Forgot password?
              <% end %>
            </div>
          </div>

          <%= button_component(width: :full) do %>
            Sign in
          <% end %>
        </div>
      <% end %>

      <div>
        <div class="relative mt-10">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-gray-200"></div>
          </div>
          <div class="relative flex justify-center text-sm/6 font-medium">
            <span class="bg-white px-6 text-gray-900">Or continue with</span>
          </div>
        </div>

        <%= oauth_buttons_component %>
      </div>
    <% end %>

    <p class="mt-10 text-center text-sm/6 text-gray-500">
      Not a member?
      <%= link_component(href: new_user_registration_path) do %>
        Sign up
      <% end %>
    </p>
  </div>
</div>
