<%= card_component do |card| %>
  <% card.with_header do %>
    <div class="flex items-center gap-2">
      <div class="flex gap-3 items-center">
        <%= avatar_component(account: @account) %>

        <h2 class="text-base/7 font-semibold">
          <%= link_component(href: url_for(@account)) do %>
            <%= @account.name %>
          <% end %>
        </h2>
      </div>

      <%= heroicon 'chevron-right', options: { class: 'size-5 text-gray-400' } %>

      <h2 class="text-base/7 font-semibold text-gray-900">
        <%= @account_user.full_name %>
      </h2>
    </div>
  <% end %>

  <p class="text-sm">
    Editing account permissions for <%= @account_user.full_name %>
  </p>

  <%= component_form_with(model: @account_user) do |form| %>
    <%= form.radio_buttons_component(:role, disabled: !policy(@account_user).update?) do |radio_buttons| %>
      <% radio_buttons.with_option(value: 'admin') %>
      <% radio_buttons.with_option(value: 'member') %>
    <% end %>

    <div class="mt-4 flex gap-3">
      <%= button_component(disabled: !policy(@account_user).update?) do %>
        Update
      <% end %>
      <% if policy(@account_user).destroy? %>
        <%= link_button_component(href: url_for(@account_user), data: { turbo_method: 'delete' }, color: :red) do %>
          Delete
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
